# Production runtime
NODE_ENV=production
REQUIRE_AUTH=true
PUBLIC_BASE_URL=https://admin.newleafsystem.com
ADMIN_BASE_URL=https://admin.newleafsystem.com
VITE_API_BASE_URL=/api/v1
CORS_ALLOWED_ORIGINS=https://admin.newleafsystem.com

# Firebase / Google Cloud
FIREBASE_PROJECT_ID=newleaf-trading
FIREBASE_STORAGE_BUCKET=
FIRESTORE_DATABASE_ID=newleafdb
FIRESTORE_COLLECTION_PREFIX=
FIREBASE_USE_APPLICATION_DEFAULT=true
FIREBASE_ADMIN_DISABLED=false
FIREBASE_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Production repository and storage
REPOSITORY_PROVIDER=firestore
LOCAL_DATA_DIR=/tmp/newleaf-api
ASSET_STORAGE_PROVIDER=gcs
ASSET_STORAGE_BUCKET=
VIDEO_STORAGE_DIR=/tmp/newleaf-video-assembler

# Google Cloud deployment
GCP_PROJECT_ID=newleaf-trading
GCP_REGION=us-central1
GOOGLE_CLOUD_RUN_REGION=us-central1
GOOGLE_CLOUD_RUN_API_SERVICE=newleaf-api
GOOGLE_CLOUD_RUN_RENDERER_SERVICE=newleaf-ffmpeg-renderer
SKIP_ENABLE_APIS=true
SKIP_PROVISIONING=true
CLOUD_BUILD_SUPPRESS_LOGS=true
GCS_BUCKET=
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=media-jobs

# Cloud Run media renderer
MEDIA_RENDERER_URL=
MEDIA_RENDER_HMAC_SECRET=
MAX_RENDER_REQUEST_BYTES=1048576
KEEP_RENDER_TEMP=false

# Service API and vendor access
SERVICE_API_KEY_HASHES=
SERVICE_API_RATE_LIMIT_PER_MINUTE=20
SERVICE_API_SIGNATURE_TOLERANCE_SEC=300
TOKEN_ENCRYPTION_KEY=

# AI review and transcription
AI_PROVIDER=openai
AI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=
AI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AI_TRANSCRIPTION_BASE_URL=
AI_MAX_TRANSCRIPTION_BYTES=26214400

# HeyGen
HEYGEN_API_KEY=
HEYGEN_API_BASE_URL=https://api.heygen.com
HEYGEN_CALLBACK_URL=https://admin.newleafsystem.com/api/v1/webhooks/heygen
HEYGEN_WEBHOOK_SECRET=
HEYGEN_WEBHOOK_ENDPOINT_ID=
HEYGEN_SIGNATURE_HEADER=signature
HEYGEN_TIMESTAMP_HEADER=x-heygen-timestamp

# FFmpeg tools are provided by the Cloud Run renderer image in production.
FFMPEG_PATH=
FFPROBE_PATH=
FFMPEG_FONT_FILE=

# Social publishing
SOCIAL_CALLBACK_BASE_URL=https://admin.newleafsystem.com
SOCIAL_PUBLISH_ENABLED_PLATFORMS=youtube x linkedin instagram facebook
SOCIAL_AUTO_RESUME_QUEUED_UPLOADS=true
SOCIAL_PUBLISH_STATUS_MAX_POLLS=20
SOCIAL_ACCOUNTS_CONFIG_PATH=

# YouTube OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://admin.newleafsystem.com/api/v1/social/youtube/oauth/callback
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/youtube.force-ssl
YOUTUBE_DEFAULT_PRIVACY_STATUS=private
YOUTUBE_DEFAULT_CATEGORY_ID=22
YOUTUBE_UPLOAD_CHUNK_BYTES=8388608
YOUTUBE_AUTO_RESUME_QUEUED_UPLOADS=true

# X / Twitter OAuth
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://admin.newleafsystem.com/api/v1/social/x/oauth/callback
X_SCOPES=tweet.read users.read tweet.write media.write offline.access
X_UPLOAD_CHUNK_BYTES=4194304

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://admin.newleafsystem.com/api/v1/social/linkedin/oauth/callback
LINKEDIN_SCOPES=openid profile email w_member_social r_organization_social
LINKEDIN_API_VERSION=202604

# Meta / Instagram / Facebook OAuth
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://admin.newleafsystem.com/api/v1/social/meta/oauth/callback
META_GRAPH_VERSION=v21.0
META_FACEBOOK_SCOPES=pages_show_list pages_manage_posts pages_read_engagement
META_INSTAGRAM_SCOPES=pages_show_list pages_read_engagement instagram_basic instagram_content_publish

# TikTok OAuth
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://admin.newleafsystem.com/api/v1/social/tiktok/oauth/callback

# GitHub Actions deployment setup.
# These values are consumed by scripts/setup-github-actions-config.sh only.
GCP_WORKLOAD_IDENTITY_PROVIDER=
GCP_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_NEWLEAF_TRADING_FILE=
