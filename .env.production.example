# Production / GitHub Actions deployment template.
# Use this as the source for GitHub repository variables and secrets.
# Keep real secrets outside git.

# Runtime
NODE_ENV=production
REQUIRE_AUTH=true
AUTH_ADMIN_EMAILS=
PUBLIC_BASE_URL=https://admin.newleafsystem.com
ADMIN_BASE_URL=https://admin.newleafsystem.com
VITE_API_BASE_URL=/api/v1
CORS_ALLOWED_ORIGINS=https://admin.newleafsystem.com

# Firebase web SDK public config for the admin UI
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=newleaf-trading.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=newleaf-trading
VITE_FIREBASE_STORAGE_BUCKET=newleaf-trading.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=240392819045
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase / Firestore / backend storage
FIREBASE_PROJECT_ID=newleaf-trading
FIRESTORE_DATABASE_ID=newleafdb
FIREBASE_USE_APPLICATION_DEFAULT=true
FIREBASE_ADMIN_DISABLED=false
REPOSITORY_PROVIDER=firestore
LOCAL_DATA_DIR=/tmp/newleaf-api
GCS_BUCKET=newleaf-trading.firebasestorage.app

# Google Cloud Run deployment
GCP_PROJECT_ID=newleaf-trading
GCP_REGION=us-central1
GOOGLE_CLOUD_RUN_API_SERVICE=newleaf-api
GOOGLE_CLOUD_RUN_RENDERER_SERVICE=newleaf-ffmpeg-renderer
SKIP_ENABLE_APIS=true
SKIP_PROVISIONING=true
CLOUD_BUILD_SUPPRESS_LOGS=true

# Cloud Run media renderer
MEDIA_RENDERER_URL=
MEDIA_RENDER_HMAC_SECRET=

# Service API and encryption
SERVICE_API_KEY_HASHES=
TOKEN_ENCRYPTION_KEY=

# AI review and transcription
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# HeyGen
HEYGEN_API_KEY=
HEYGEN_CALLBACK_URL=https://admin.newleafsystem.com/api/v1/webhooks/heygen
HEYGEN_WEBHOOK_SECRET=

# Social publishing
SOCIAL_CALLBACK_BASE_URL=https://admin.newleafsystem.com
SOCIAL_PUBLISH_ENABLED_PLATFORMS=youtube x

# YouTube OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/youtube.force-ssl

# X / Twitter OAuth
X_CLIENT_ID=
X_CLIENT_SECRET=
X_SCOPES=tweet.read users.read tweet.write media.write offline.access

# Optional LinkedIn OAuth
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Optional Meta / Instagram / Facebook OAuth
# META_APP_ID=
# META_APP_SECRET=

# Optional TikTok OAuth
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# GitHub Actions OIDC deployment
GCP_WORKLOAD_IDENTITY_PROVIDER=
GCP_SERVICE_ACCOUNT=
