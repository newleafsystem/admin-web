rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function roleList() {
      return signedIn() && request.auth.token.roles is list
        ? request.auth.token.roles
        : [];
    }

    function canReadAssets() {
      return roleList().hasAny(['admin', 'editor', 'reviewer', 'publisher', 'viewer']);
    }

    match /jobs/{jobId}/{allPaths=**} {
      allow read: if canReadAssets();
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
