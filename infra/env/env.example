APP_STAGE=development
LOG_LEVEL=debug

PUBLIC_APP_NAME=NewLeaf
PUBLIC_API_BASE_URL=http://localhost:8081/api/v1
PUBLIC_FIREBASE_PROJECT_ID=newleaf-dev

FIREBASE_PROJECT_ID=newleaf-dev
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

ASSET_STORAGE_PROVIDER=gcs
GCS_BUCKET=newleaf-assets-dev

QUEUE_PROVIDER=cloud_tasks
CLOUD_TASKS_QUEUE=content-workflows-dev

HEYGEN_WEBHOOK_PATH=/api/v1/webhooks/heygen
ALLOWED_ORIGINS=http://localhost:5173

HEYGEN_API_KEY_SECRET=projects/newleaf-dev/secrets/heygen-api-key/versions/latest
HEYGEN_WEBHOOK_SECRET_NAME=projects/newleaf-dev/secrets/heygen-webhook-secret/versions/latest
INTERNAL_API_TOKEN_SECRET=projects/newleaf-dev/secrets/internal-api-token/versions/latest
SOCIAL_TOKEN_KEY_SECRET=projects/newleaf-dev/secrets/social-token-encryption-key/versions/latest
