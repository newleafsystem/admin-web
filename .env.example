# Local development environment.
# Copy this file to .env for local API + Vite work.
# Keep real secrets in .env only. Do not commit .env.

# Runtime
NODE_ENV=development
PORT=8080
REQUIRE_AUTH=false
PUBLIC_BASE_URL=http://localhost:8080
ADMIN_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173 http://127.0.0.1:5173

# Local repository and storage
REPOSITORY_PROVIDER=local
LOCAL_DATA_DIR=.local-data

# Optional Firebase web SDK public config for local auth-enabled UI testing
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional Firebase Admin / Firestore local testing
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=newleafdb
FIREBASE_USE_APPLICATION_DEFAULT=false
FIREBASE_ADMIN_DISABLED=false

# Optional local object storage. Leave unset to use .local-data.
GCS_BUCKET=

# AI review and transcription
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# HeyGen
HEYGEN_API_KEY=

# Social publishing
SOCIAL_CALLBACK_BASE_URL=http://localhost:8080
SOCIAL_PUBLISH_ENABLED_PLATFORMS=youtube x
SOCIAL_PUBLICATION_SYNC_ENABLED=true
SOCIAL_PUBLICATION_SYNC_INTERVAL_MS=3600000
SOCIAL_PUBLICATION_SYNC_MAX_RESULTS=100
SOCIAL_ACCOUNTS_CONFIG_PATH=config/social-accounts.local.json

# YouTube OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8080/api/v1/social/youtube/oauth/callback
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/youtube.force-ssl

# X / Twitter OAuth
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8080/api/v1/social/x/oauth/callback
X_SCOPES=tweet.read users.read tweet.write media.write offline.access
X_UPLOAD_CHUNK_BYTES=4194304
