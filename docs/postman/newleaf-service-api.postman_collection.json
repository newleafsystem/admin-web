{
  "info": {
    "name": "NewLeaf Service API",
    "_postman_id": "b3dd6d3f-5086-4686-a450-79e3c5a093bb",
    "description": "Developer collection for the protected NewLeaf backend-to-backend Service API. Set collection variables only; do not store real secrets in the collection file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const keyId = pm.collectionVariables.get('serviceKeyId');",
          "const signingSecret = pm.collectionVariables.get('serviceSigningSecret');",
          "if (!keyId || !signingSecret) {",
          "  throw new Error('Set serviceKeyId and serviceSigningSecret collection variables before sending signed Service API requests.');",
          "}",
          "",
          "const timestamp = Math.floor(Date.now() / 1000).toString();",
          "const method = pm.request.method.toUpperCase();",
          "const pathWithQuery = pm.variables.replaceIn(pm.request.url.getPathWithQuery());",
          "const bodyTemplate = pm.request.body && pm.request.body.mode === 'raw' ? (pm.request.body.raw || '') : '';",
          "const rawBody = pm.variables.replaceIn(bodyTemplate);",
          "const bodyHash = CryptoJS.SHA256(CryptoJS.enc.Utf8.parse(rawBody)).toString(CryptoJS.enc.Hex);",
          "const signaturePayload = [method, pathWithQuery, timestamp, bodyHash].join('\\n');",
          "const signature = CryptoJS.HmacSHA256(signaturePayload, signingSecret).toString(CryptoJS.enc.Hex);",
          "",
          "pm.request.headers.upsert({ key: 'x-newleaf-key-id', value: keyId });",
          "pm.request.headers.upsert({ key: 'x-newleaf-timestamp', value: timestamp });",
          "pm.request.headers.upsert({ key: 'x-newleaf-signature', value: `sha256=${signature}` });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.newleafsystem.com/api/v1",
      "type": "string"
    },
    {
      "key": "serviceKeyId",
      "value": "",
      "type": "string"
    },
    {
      "key": "serviceSigningSecret",
      "value": "",
      "type": "secret"
    },
    {
      "key": "serviceApiKey",
      "value": "",
      "type": "secret"
    },
    {
      "key": "jobId",
      "value": "",
      "type": "string"
    },
    {
      "key": "artifactId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create text-to-HeyGen job",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('job accepted or replayed', function () {",
              "  pm.expect([200, 201, 202]).to.include(pm.response.code);",
              "});",
              "const data = pm.response.json();",
              "if (data.job && data.job.id) {",
              "  pm.collectionVariables.set('jobId', data.job.id);",
              "}",
              "if (Array.isArray(data.artifacts) && data.artifacts[0] && data.artifacts[0].id) {",
              "  pm.collectionVariables.set('artifactId', data.artifacts[0].id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "content-type",
            "value": "application/json"
          },
          {
            "key": "x-newleaf-api-key",
            "value": "{{serviceApiKey}}",
            "disabled": true,
            "description": "Legacy fallback only. Prefer signed service client headers generated by the collection pre-request script."
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"BABA Iron Condor\",\n  \"script\": \"Create a short educational NewLeaf market video. Include defined-risk language and avoid guaranteed-profit claims.\",\n  \"targetDurationSec\": 240,\n  \"idempotencyKey\": \"postman-baba-iron-condor-001\",\n  \"segmentMode\": \"single\",\n  \"autoStart\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/service/text-to-heygen/jobs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "service",
            "text-to-heygen",
            "jobs"
          ]
        },
        "description": "Creates a service-owned text-to-HeyGen job. Requires a signed service client with the text_to_heygen scope."
      },
      "response": []
    },
