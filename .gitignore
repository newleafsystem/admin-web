# Dependencies
node_modules/
**/node_modules/

# Build output and caches
dist/
build/
.vite/
.turbo/
.next/
coverage/

# Runtime and local data
.dev-logs/
.local-data/
apps/api/.local-data/
packages/*/temp/

# Local media scratch folders. Keep placeholders only.
input/*
!input/.gitkeep
output/*
!output/.gitkeep
temp/*
!temp/.gitkeep
apps/api/input/
apps/api/output/
apps/api/temp/
apps/api/manifests/

# Environment and secrets
.env
.env.*
!.env.example
!.env.*.example
.secrets/
.runtimeconfig.json
service-account*.json
credentials*.json
tokens*.json
*-credentials.json
*-service-account.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# Firebase and Google Cloud generated files
.firebase/
firebase-export-*/
firestore_export/
*.firebase.local

# Cloudflare leftovers
.wrangler/
.dev.vars

# OS/editor noise
.DS_Store
Thumbs.db
